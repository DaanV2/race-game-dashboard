{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Visual",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "args": [
                "visual",
                "--boardId=FgG:11706",
                "--log-level=debug"
            ]
        },
        {
            "name": "Launch Visual BoardXY",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "args": [
                "visual",
                "boardxy",
                "--log-level=debug"
            ]
        },
        {
            "name": "debug cmd/tree",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "env": {
                "NO_SPINNERS": "true"
            },
            "args": [
                "generators",
                "stats",
                "--brute-force-3pieces",
                "--log-level",
                "debug",
            ]
        },
        {
            "name": "debug cmd/generators/stats --start-tree",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "env": {
                "NO_SPINNERS": "true"
            },
            "args": [
                "generators",
                "stats",
                // "--ingest-logs=./data/generation/logs",
                "--start-tree",
                "--log-report-caller=true",
                "--log-level",
                "debug",
            ]
        },
        {
            "name": "debug strategies/trees",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "env": {
                "NO_SPINNERS": "true"
            },
            "args": [
                "strategies",
                "trees",
                "--log-report-caller=true",
                "--log-level",
                "debug",
                "--depth",
                "6",
                "--use-stats-db=false",
            ]
        },
        {
            "name": "debug ingest/logs",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "env": {
                "NO_SPINNERS": "true"
            },
            "args": [
                "ingest",
                "logs",
                "--log-report-caller=true",
                "--log-level",
                "debug",
                "data/generation/logs"
            ]
        }
    ]
}